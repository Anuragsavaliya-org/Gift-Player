node_modules
dist

# real marketplace files for `npm run verify:corpus` (owner drops them here; never committed)
samples/corpus/

# scratch space for temporary files
.scratch/

# frames dumped from Chromium for cross-browser comparison (regenerated by verify:images)
samples/.golden/

# system fonts copied here for the font-registration test (not redistributable)
samples/.fonts/

# generated API reference (npm run docs)
docs/api/

# per-browser outputs of `--browser=<name>` runs (CI artifacts; the committed reports are the default runs)
reports/*-chromium.*
reports/*-firefox.*
reports/*-webkit.*

# .svga and .webp files are never committed (we do not redistribute them): `npm run samples:generate` creates stand-ins and the
# synthetic WebP files; a developer may also keep real files here. See samples/THIRD_PARTY.md.
samples/**/*.svga
samples/**/*.webp
samples/expected.json

# the real corpus is private: its reports (file names, features) are not committed either
reports/corpus*.json
reports/corpus*.md
