{
  "name": "@incodes/gift-player",
  "version": "0.0.0",
  "description": "Play animated gift files (SVGA, GIF, WebP, PAG) through one API.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "advanced": [
        "./dist/advanced.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      },
      "require": {
        "types": "./dist/advanced.d.cts",
        "default": "./dist/advanced.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/fix-react-entry.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "playground": "vite playground",
    "samples:expected": "node scripts/gen-expected.cjs",
    "verify:browser": "node scripts/verify-all.mjs",
    "verify:corpus": "node scripts/verify-corpus.mjs",
    "gen:synthetic": "node scripts/gen-synthetic.mjs",
    "verify:images": "node scripts/verify-images.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify:pag": "node scripts/verify-pag.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "libpag": "4.5.85",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svgaplayerweb": "^2.3.2",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
