{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@gift-player/root": ["./src/index.ts"] }
  },
  "include": ["src", "tests", "playground", "tools"]
}
